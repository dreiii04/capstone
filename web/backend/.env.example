NODE_ENV=development
PORT=5000

# Required in every deployed environment.
MONGODB_URI=
# Keep this identical in every web/mobile backend deployment. Current
# production records are in the legacy database named "test".
MONGODB_DB_NAME=test
JWT_SECRET=

# Comma-separated HTTPS web origins. Native mobile requests have no Origin.
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
TRUST_PROXY_HOPS=0

# Business days counted from the day after a request enters In Process.
# Set the school-approved default and optional exact document-name overrides.
DEFAULT_DOCUMENT_PROCESSING_DAYS=5
DOCUMENT_PROCESSING_DAYS={}

# Session lifetime controls.
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_DAYS=30

# OTP email delivery. OTP_DEV_MODE must remain false in production.
OTP_DEV_MODE=false
# Generic SMTP configuration (recommended; works with Brevo and other relays).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Legacy Gmail configuration is still supported when SMTP_HOST is blank.
SMTP_EMAIL=
SMTP_PASSWORD=

# Media storage.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blockchain document-registry integration. Production issuance fails closed
# unless all three values are configured and reachable.
BESU_RPC_URL=
DOCUMENT_REGISTRY_CONTRACT_ADDRESS=
SERVER_WALLET_PRIVATE_KEY=

# Development only; never enable this in production.
SEED_DEFAULT_USERS=false
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
